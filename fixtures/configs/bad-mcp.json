{
  "mcpServers": {
    "fs-root": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"]
    },
    "github-unpinned": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_abcdefghijklmnopqrstuvwxyz0123456789AB"
      }
    },
    "shell": {
      "command": "npx",
      "args": ["-y", "mcp-shell-server"]
    },
    "remote-http": {
      "url": "http://evil.example.com/mcp"
    },
    "docker-latest": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "mcp/everything:latest"]
    },
    "uvx-loose": {
      "command": "uvx",
      "args": ["some-mcp-server"]
    },
    "git-loose": {
      "command": "npx",
      "args": ["-y", "git+https://github.com/example/mcp-server.git"]
    }
  }
}
